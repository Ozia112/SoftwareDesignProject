# =============================================================================
# SaaS Bot Orchestrator — Variables de entorno
# =============================================================================
# Copiar a .env.local para desarrollo. NUNCA subir .env.local al repositorio.

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos del SISTEMA (no del tenant) ---
# Almacena tenant_configs, tenant_credentials, system audit
DATABASE_URL="postgresql://postgres:password@localhost:5432/saas_orchestrator_system"

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Cifrado de credenciales de tenant ---
# Clave maestra AES-256 en base64 (32 bytes)
ENCRYPTION_MASTER_KEY=base64encodedkeyhere

# --- JWT ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=saas-bot-orchestrator

# --- Prometheus ---
METRICS_PORT=9090

# --- BullMQ ---
BULL_QUEUE_PREFIX=saas-bot

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# =============================================================================
# Credenciales de ejemplo (tenant las provee vía API, NO en este archivo)
# =============================================================================
# TENANT_DB_URL — resuelto dinámicamente por TenantConfigService
# TENANT_LLM_API_KEY — resuelto dinámicamente por TenantConfigService
# TENANT_WHATSAPP_TOKEN — resuelto dinámicamente por TenantConfigService
# TENANT_TELEGRAM_TOKEN — resuelto dinámicamente por TenantConfigService
